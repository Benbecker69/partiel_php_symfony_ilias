{% extends 'base.html.twig' %}

{% block title %}Admin - Nouvel evenement{% endblock %}

{% block body %}
<h1>Creer un nouvel evenement</h1>

<div class="card mt-4">
    <div class="card-body">
        {{ form_start(form) }}
            <div class="mb-3">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.date) }}
                {{ form_widget(form.date) }}
                {{ form_errors(form.date) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.location) }}
                {{ form_widget(form.location) }}
                {{ form_errors(form.location) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.capacity) }}
                {{ form_widget(form.capacity) }}
                {{ form_errors(form.capacity) }}
            </div>
            <button type="submit" class="btn btn-primary">Creer</button>
            <a href="{{ path('admin_event_index') }}" class="btn btn-secondary">Annuler</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
