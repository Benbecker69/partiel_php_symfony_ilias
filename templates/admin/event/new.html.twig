{% extends 'base.html.twig' %}

{% block title %}Nouvel evenement{% endblock %}

{% block body %}
<a href="{{ path('admin_event_index') }}" class="btn btn-secondary mb-4">Retour</a>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="mb-4">Nouvel evenement</h1>
                {{ form_start(form) }}
                    <div class="mb-3">{{ form_label(form.title) }}{{ form_widget(form.title) }}{{ form_errors(form.title) }}</div>
                    <div class="mb-3">{{ form_label(form.description) }}{{ form_widget(form.description) }}{{ form_errors(form.description) }}</div>
                    <div class="row">
                        <div class="col-md-6 mb-3">{{ form_label(form.date) }}{{ form_widget(form.date) }}{{ form_errors(form.date) }}</div>
                        <div class="col-md-6 mb-3">{{ form_label(form.capacity) }}{{ form_widget(form.capacity) }}{{ form_errors(form.capacity) }}</div>
                    </div>
                    <div class="mb-4">{{ form_label(form.location) }}{{ form_widget(form.location) }}{{ form_errors(form.location) }}</div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Creer</button>
                        <a href="{{ path('admin_event_index') }}" class="btn btn-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
