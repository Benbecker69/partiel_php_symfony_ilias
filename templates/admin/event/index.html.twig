{% extends 'base.html.twig' %}

{% block title %}Admin - Liste des evenements{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Administration des evenements</h1>
    <a href="{{ path('admin_event_new') }}" class="btn btn-primary">Nouvel evenement</a>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

{% if events is empty %}
    <div class="alert alert-info">
        Aucun evenement pour le moment.
    </div>
{% else %}
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Date</th>
                <th>Lieu</th>
                <th>Capacite</th>
                <th>Reservations</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
            <tr>
                <td>{{ event.id }}</td>
                <td>{{ event.title }}</td>
                <td>{{ event.date|date('d/m/Y H:i') }}</td>
                <td>{{ event.location }}</td>
                <td>{{ event.capacity }}</td>
                <td>{{ event.reservations|length }}</td>
                <td>
                    <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    <form action="{{ path('admin_event_delete', {id: event.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Etes-vous sur de vouloir supprimer cet evenement ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                        <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
