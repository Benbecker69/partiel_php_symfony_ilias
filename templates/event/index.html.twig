{% extends 'base.html.twig' %}

{% block title %}Evenements{% endblock %}

{% block body %}
<h1 class="mb-4">Evenements a venir</h1>

{% if events is empty %}
    <div class="alert alert-info">Aucun evenement a venir pour le moment.</div>
{% else %}
    <div class="row">
        {% for event in events %}
        {% set placesRestantes = event.capacity - event.reservations|length %}
        <div class="col-12 col-sm-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">{{ event.title }}</h5>
                        {% if app.user and event.id in reservedEventIds %}
                            <span class="badge bg-success">Reserve</span>
                        {% elseif placesRestantes <= 0 %}
                            <span class="badge badge-complet">Complet</span>
                        {% endif %}
                    </div>

                    <p class="text-muted small mb-3">{{ event.description|slice(0, 80) }}{% if event.description|length > 80 %}...{% endif %}</p>

                    <div class="event-meta">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        {{ event.date|date('d/m/Y a H:i') }}
                    </div>
                    <div class="event-meta">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        {{ event.location }}
                    </div>
                    <div class="event-meta">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        {% if placesRestantes > 0 %}
                            {{ placesRestantes }} place{{ placesRestantes > 1 ? 's' : '' }} restante{{ placesRestantes > 1 ? 's' : '' }}
                        {% else %}
                            Complet
                        {% endif %}
                    </div>
                </div>
                <div class="card-footer">
                    <a href="{{ path('app_event_show', {id: event.id}) }}" class="btn btn-primary w-100">Voir les details</a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
